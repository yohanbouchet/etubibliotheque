{
  "info": {
    "name": "EtuBibliothèque",
    "description": "Requêtes de test de l'API EtuBibliothèque. Ordre conseillé : 1) Inscription d'un agent de démonstration, 2) Connexion, qui enregistre automatiquement le token JWT dans la variable {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "login", "value": "agent.demo" },
    { "key": "password", "value": "Demo1234!" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Authentification",
      "item": [
        {
          "name": "1 - Inscription d'un agent (POST /api/register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 201 = agent créé ; 400 = l'agent de démonstration existe déjà (inscription déjà faite)",
                  "pm.test(\"Statut 201 Created (ou 400 si l'agent existe déjà)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Agent\",\n  \"lastName\": \"Demo\",\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "register"]
            }
          }
        },
        {
          "name": "2 - Connexion (POST /api/login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"La réponse contient un token JWT\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
                  "    // Le token est mémorisé pour les requêtes protégées (Authorization: Bearer {{token}})",
                  "    pm.collectionVariables.set(\"token\", body.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            }
          }
        }
      ]
    }
  ]
}
