# Lombok marque le code qu'il génère (getters, setters, constructeurs...) avec l'annotation @Generated.
# JaCoCo reconnaît cette annotation et exclut ce code du calcul de couverture :
# on ne mesure que le code écrit à la main, qui contient la logique à tester.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
